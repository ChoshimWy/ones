/config/*
!/config/*.example.json
.env
.env.*
*.local.json
*.local.yaml
*.local.yml
/.secrets/
/.auth/
/credentials*
/cookies*
/tokens*
*.pem
*.key
*.p12
*.pfx

# Raw exports, captures and logs may contain credentials or personal data.
/exports/
/captures/
/artifacts/
/logs/
*.har
*.log
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.db
*.db-*

